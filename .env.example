# Public API origin used by the browser in production. This is not a secret.
# Omit only to intentionally use the existing Railway API fallback in src/config/api.ts.
VITE_API_BASE_URL=https://villa-penas-production.up.railway.app

# Public origin used for canonical URLs and generated sitemap.xml.
# Set this to the Railway frontend URL for a test deployment, then update it to the final custom domain.
VITE_SITE_URL=
